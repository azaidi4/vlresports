{
  "name": "vrlggscraper",
  "version": "1.0.3",
  "description": "A simple API for Valorant Esports Scraper",
  "type": "module",
  "scripts": {
    "start": "tsx src/",
    "dev": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "docker": "docker compose build --no-cache && docker compose up -d"
  },
  "keywords": [
    "valorant",
    "scraper",
    "api",
    "valorant-api",
    "valorant-scraper",
    "valorant-api-scraper",
    "valorant-api-scraper",
    "esports",
    "valorant-esports",
    "valorant-esports-api",
    "valorant-esports-scrap"
  ],
  "author": "Orloxx23",
  "license": "Apache-2.0",
  "dependencies": {
    "apicache": "^1.6.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "cron": "^4.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "ioredis": "^5.5.0",
    "node-html-parser": "^7.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/apicache": "^1.6.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0"
  }
}
